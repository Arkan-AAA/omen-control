import { Button, VerticalBox, HorizontalBox, ScrollView, ComboBox, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <string> cpu-temp: "n/a";
    in property <string> gpu-temp: "n/a";
    in property <string> fan-rpm: "n/a";
    in property <string> cpu-usage: "n/a";
    in property <string> gpu-usage: "n/a";
    in-out property <int> current-page: 0;

    width: 1100px;
    height: 700px;
    background: #0a0a0f;
    title: "OMEN Control";

    HorizontalBox {
        // Sidebar
        Rectangle {
            width: 220px;
            background: #12121a;
            VerticalBox {
                padding: 20px;
                spacing: 8px;
                Text { text: "OMEN"; font-size: 24px; font-weight: 700; color: #ff4655; }
                Text { text: "Control"; font-size: 12px; color: #666; }
                Rectangle { height: 20px; }
                Button { text: "Dashboard"; clicked => { current-page = 0; } }
                Button { text: "Performance"; clicked => { current-page = 1; } }
                Button { text: "Lighting"; clicked => { current-page = 2; } }
                Button { text: "Fans"; clicked => { current-page = 3; } }
                Button { text: "System Vitals"; clicked => { current-page = 4; } }
                Button { text: "Network"; clicked => { current-page = 5; } }
                Button { text: "Settings"; clicked => { current-page = 6; } }
            }
        }

        // Main content
        Rectangle {
            background: #0a0a0f;
            VerticalBox {
                padding: 30px;
                spacing: 20px;

                if current-page == 0 : VerticalBox {
                    Text { text: "Dashboard"; font-size: 28px; font-weight: 700; color: #fff; }
                    HorizontalBox {
                        spacing: 16px;
                        Rectangle {
                            background: #1a1a24;
                            border-radius: 12px;
                            width: 240px; height: 120px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: "CPU Temp"; color: #888; font-size: 12px; }
                                Text { text: root.cpu-temp; font-size: 32px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle {
                            background: #1a1a24;
                            border-radius: 12px;
                            width: 240px; height: 120px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: "GPU Temp"; color: #888; font-size: 12px; }
                                Text { text: root.gpu-temp; font-size: 32px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle {
                            background: #1a1a24;
                            border-radius: 12px;
                            width: 240px; height: 120px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: "Fan RPM"; color: #888; font-size: 12px; }
                                Text { text: root.fan-rpm; font-size: 32px; font-weight: 700; color: #fff; }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 16px;
                        Rectangle {
                            background: #1a1a24;
                            border-radius: 12px;
                            width: 240px; height: 120px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: "CPU Usage"; color: #888; font-size: 12px; }
                                Text { text: root.cpu-usage; font-size: 32px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle {
                            background: #1a1a24;
                            border-radius: 12px;
                            width: 240px; height: 120px;
                            VerticalBox {
                                padding: 16px;
                                Text { text: "GPU Usage"; color: #888; font-size: 12px; }
                                Text { text: root.gpu-usage; font-size: 32px; font-weight: 700; color: #fff; }
                            }
                        }
                    }
                }

                if current-page == 1 : VerticalBox {
                    Text { text: "Performance"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "Performance mode switching coming soon."; color: #888; }
                }

                if current-page == 2 : VerticalBox {
                    Text { text: "Lighting"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "RGB control coming soon."; color: #888; }
                }

                if current-page == 3 : VerticalBox {
                    Text { text: "Fans"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "Fan curve editor coming soon."; color: #888; }
                }

                if current-page == 4 : VerticalBox {
                    Text { text: "System Vitals"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "Detailed sensors coming soon."; color: #888; }
                }

                if current-page == 5 : VerticalBox {
                    Text { text: "Network"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "Network booster coming soon."; color: #888; }
                }

                if current-page == 6 : VerticalBox {
                    Text { text: "Settings"; font-size: 28px; font-weight: 700; color: #fff; }
                    Text { text: "Settings coming soon."; color: #888; }
                }
            }
        }
    }
}
