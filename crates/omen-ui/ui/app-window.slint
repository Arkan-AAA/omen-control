import { Button, VerticalBox, HorizontalBox, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <string> cpu-temp: "n/a";
    in property <string> gpu-temp: "n/a";
    in property <string> fan-rpm: "n/a";
    in property <string> cpu-usage: "n/a";
    in property <string> gpu-usage: "n/a";
    in property <string> perf-status: "n/a";
    in property <string> net-rx: "n/a";
    in property <string> net-tx: "n/a";
    in-out property <int> current-page: 0;

    callback set-performance-mode(string);
    callback set-fan-speed(float);

    width: 1200px;
    height: 760px;
    background: #0d0d12;
    title: "OMEN Control";

    HorizontalBox {
        // Sidebar
        Rectangle {
            width: 240px;
            background: #13131c;
            VerticalBox {
                padding: 24px;
                spacing: 6px;
                Text { text: "OMEN"; font-size: 26px; font-weight: 800; color: #ff4655; }
                Text { text: "Control Center"; font-size: 11px; color: #555; letter-spacing: 1px; }
                Rectangle { height: 24px; }
                Button { text: "Dashboard"; clicked => { current-page = 0; } }
                Button { text: "Performance"; clicked => { current-page = 1; } }
                Button { text: "Lighting"; clicked => { current-page = 2; } }
                Button { text: "Fans"; clicked => { current-page = 3; } }
                Button { text: "System Vitals"; clicked => { current-page = 4; } }
                Button { text: "Network"; clicked => { current-page = 5; } }
                Button { text: "Settings"; clicked => { current-page = 6; } }
            }
        }

        // Main
        Rectangle {
            background: #0d0d12;
            VerticalBox {
                padding: 32px;
                spacing: 24px;

                if current-page == 0 : VerticalBox {
                    Text { text: "Dashboard"; font-size: 30px; font-weight: 700; color: #fff; }
                    HorizontalBox {
                        spacing: 18px;
                        Rectangle { background: #1a1a26; border-radius: 14px; width: 260px; height: 130px;
                            VerticalBox { padding: 18px; spacing: 4px;
                                Text { text: "CPU TEMPERATURE"; color: #666; font-size: 11px; }
                                Text { text: root.cpu-temp; font-size: 36px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle { background: #1a1a26; border-radius: 14px; width: 260px; height: 130px;
                            VerticalBox { padding: 18px; spacing: 4px;
                                Text { text: "GPU TEMPERATURE"; color: #666; font-size: 11px; }
                                Text { text: root.gpu-temp; font-size: 36px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle { background: #1a1a26; border-radius: 14px; width: 260px; height: 130px;
                            VerticalBox { padding: 18px; spacing: 4px;
                                Text { text: "FAN SPEED"; color: #666; font-size: 11px; }
                                Text { text: root.fan-rpm; font-size: 36px; font-weight: 700; color: #fff; }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 18px;
                        Rectangle { background: #1a1a26; border-radius: 14px; width: 260px; height: 130px;
                            VerticalBox { padding: 18px; spacing: 4px;
                                Text { text: "CPU USAGE"; color: #666; font-size: 11px; }
                                Text { text: root.cpu-usage; font-size: 36px; font-weight: 700; color: #fff; }
                            }
                        }
                        Rectangle { background: #1a1a26; border-radius: 14px; width: 260px; height: 130px;
                            VerticalBox { padding: 18px; spacing: 4px;
                                Text { text: "GPU USAGE"; color: #666; font-size: 11px; }
                                Text { text: root.gpu-usage; font-size: 36px; font-weight: 700; color: #fff; }
                            }
                        }
                    }
                }

                if current-page == 1 : VerticalBox {
                    Text { text: "Performance"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "Switch power profile (may require admin)."; color: #666; font-size: 12px; }
                    HorizontalBox {
                        spacing: 12px;
                        Button { text: "Balanced"; clicked => { root.set-performance-mode("Balanced"); } }
                        Button { text: "Performance"; clicked => { root.set-performance-mode("Performance"); } }
                        Button { text: "Quiet"; clicked => { root.set-performance-mode("Quiet"); } }
                    }
                    Rectangle { background: #1a1a26; border-radius: 10px; height: 60px;
                        VerticalBox { padding: 14px;
                            Text { text: root.perf-status; color: #aaa; }
                        }
                    }
                }

                if current-page == 2 : VerticalBox {
                    Text { text: "Lighting"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "RGB control coming soon (requires HID reverse engineering)."; color: #666; }
                }

                if current-page == 3 : VerticalBox {
                    Text { text: "Fans"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "Fan speed: " + root.fan-rpm; color: #aaa; }
                    Text { text: "Manual fan curve editor coming soon."; color: #666; }
                }

                if current-page == 4 : VerticalBox {
                    Text { text: "System Vitals"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "CPU: " + root.cpu-temp + "  |  GPU: " + root.gpu-temp; color: #aaa; }
                    Text { text: "CPU usage: " + root.cpu-usage + "  |  GPU usage: " + root.gpu-usage; color: #aaa; }
                }

                if current-page == 5 : VerticalBox {
                    Text { text: "Network"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "Download: " + root.net-rx; color: #aaa; }
                    Text { text: "Upload: " + root.net-tx; color: #aaa; }
                    Text { text: "Network booster coming soon."; color: #666; }
                }

                if current-page == 6 : VerticalBox {
                    Text { text: "Settings"; font-size: 30px; font-weight: 700; color: #fff; }
                    Text { text: "Settings coming soon."; color: #666; }
                }
            }
        }
    }
}
